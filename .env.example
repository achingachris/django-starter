# This is a template for the `.env` file that is used as part of local development.
# You can copy this file, rename it to `.env` and fill in the missing values,
# then delete this header.
###############################################################################

# This file should contain all the secrets required by *development* (local) application.
# This file is ignored by git by default to avoid accidentally exposing secrets in your repository.

SECRET_KEY="django-insecure-2iEsfxzHLTfdRLJ3rpxS5iaBzQYMR1dXU6ZCfNaa"

# Local development runs natively against SQLite. Leave DATABASE_URL unset to use the
# SQLite database at db.sqlite3 (configured in config/settings/base.py).
# In production, set DATABASE_URL to your Postgres instance, e.g.:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/chrisdevcode"

# Redis is optional for native local development: the cache uses DummyCache in DEBUG.
# Point this at a running Redis instance if you want to exercise the Redis cache locally.
# REDIS_URL="redis://localhost:6379"

# >>> web
UMAMI_WEBSITE_ID="2c9c06e2-ea49-413a-8e13-ae93a45cd034"
# <<< web


# Development server ports
DJANGO_PORT=8000

# Docker service ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# >>> web
# turnstile setup - add your keys here to enable turnstile
TURNSTILE_KEY=""
TURNSTILE_SECRET=""
# <<< web

# Front end that allauth headless email links (verify email, reset password) point at
# when HEADLESS_ONLY is on, e.g. your SPA or a mobile app's universal-link domain.
# FRONTEND_URL="http://localhost:3000"

ENABLE_DEBUG_TOOLBAR=True

# Dev superuser auto-created by `runserver` in DEBUG (defaults shown). Override if you like.
# Also the account the toolbar's "Login / out" panel logs in as.
# DEV_SUPERUSER_EMAIL="admin@example.com"
# DEV_SUPERUSER_PASSWORD="admin"

# Optionally restrict the "Login / out" panel endpoints to a single client IP.
# LOGINOUT_SERVER="127.0.0.1"

# --- Email -------------------------------------------------------------------
# In DEBUG, emails are printed to the terminal — no credentials needed, and no risk of
# emailing a real person while developing. Outside DEBUG they are sent over SMTP via Resend.

# DEFAULT_FROM_EMAIL="achinga.chris@gmail.com"
# SERVER_EMAIL="noreply@localhost:8000"

# To actually send mail from local dev (e.g. to check how a template renders in a real
# inbox), set both of these. The from-address must be on a domain verified in Resend.
# EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
# RESEND_API_KEY="re_***"

# Other SMTP providers work too — override these instead of RESEND_API_KEY.
# EMAIL_HOST="smtp.resend.com"
# EMAIL_PORT=587
# EMAIL_HOST_USER="resend"
# EMAIL_HOST_PASSWORD="re_***"
# Use port 465 with EMAIL_USE_SSL=True for implicit TLS instead of STARTTLS.
# EMAIL_USE_SSL=False
