# Production environment for the Docker Compose stack (config.settings.prod).
#
# Copy this file to `.env.prod`, then replace every "change-me" value with a real
# secret. `.env.prod` is git-ignored — never commit it.
###############################################################################

# --- Django core ------------------------------------------------------------
# REQUIRED in production. Several settings in config/settings/base.py are derived from DEBUG at
# import time (cache backend and dev-only apps such as
# django_browser_reload which are NOT installed in the prod image). Leaving this True will break
# the container, so it must be False here.
DEBUG=False

# REQUIRED — production refuses to start without it (no fallback default).
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me-to-a-long-random-secret"

# REQUIRED — comma-separated list of the domains this app is served from (no "*").
ALLOWED_HOSTS="example.com,www.example.com"

# Selects config/settings/prod.py (DEBUG=False + security headers + WhiteNoise).
DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate https:// absolute URLs (the app runs behind a TLS-terminating proxy).
USE_HTTPS_IN_ABSOLUTE_URLS=True

# --- Postgres ---------------------------------------------------------------
# Consumed by the `db` service to initialise the database, and must match DATABASE_URL below.
POSTGRES_DB=django_template
POSTGRES_USER=postgres
POSTGRES_PASSWORD="change-me-postgres-password"
# host "db" is the compose service name.
DATABASE_URL="postgresql://postgres:change-me-postgres-password@db:5432/django_template"

# --- Redis (cache) ----------------------------------------------------------
# host "redis" is the compose service name.
REDIS_URL="redis://redis:6379/0"

# --- gunicorn ---------------------------------------------------------------
# Rule of thumb: (2 x CPU cores) + 1.
GUNICORN_WORKERS=3

# --- Email ------------------------------------------------------------------
# Outside DEBUG, mail is sent over SMTP via Resend. Set RESEND_API_KEY and make sure the
# from-addresses below are on a domain you have verified in Resend, or delivery will fail.
DEFAULT_FROM_EMAIL="noreply@example.com"
SERVER_EMAIL="noreply@example.com"
RESEND_API_KEY="re_***"

# To use a different SMTP provider, override these instead of setting RESEND_API_KEY.
# EMAIL_HOST="smtp.resend.com"
# EMAIL_PORT=587
# EMAIL_HOST_USER="resend"
# EMAIL_HOST_PASSWORD="re_***"
# EMAIL_USE_SSL=False  # set True (with EMAIL_PORT=465) for implicit TLS instead of STARTTLS

# --- Error tracking (optional) ----------------------------------------------
# Sentry is enabled only when SENTRY_DSN is set.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Optional ---------------------------------------------------------------
UMAMI_WEBSITE_ID="2c9c06e2-ea49-413a-8e13-ae93a45cd034"
# TURNSTILE_KEY=""
# TURNSTILE_SECRET=""
# Move the Django admin off /admin/ (value must end with a slash).
# ADMIN_URL="admin/"
# Seconds to keep DB connections open between requests (0 disables reuse).
# CONN_MAX_AGE=60
# HSTS max-age in seconds; raise once HTTPS is proven to work (e.g. 518400).
# SECURE_HSTS_SECONDS=60
